# Backend URL — your Fly.io backend
BACKEND_URL=https://lily-cafe-pos.fly.dev

# Must match PRINT_AGENT_API_KEY in backend .env / Fly secrets
AGENT_API_KEY=change-me-in-production

# Printer type: usb | serial | network | win32
PRINTER_TYPE=usb

# USB printer — run ../backend/detect_printer.py to find your IDs
PRINTER_VENDOR_ID=04b8
PRINTER_PRODUCT_ID=0202

# Serial printer (comment out USB block above and uncomment these)
# PRINTER_TYPE=serial
# PRINTER_PORT=COM3
# PRINTER_BAUDRATE=9600

# Network/IP printer (best for permanent cafe setup — no cables)
# PRINTER_TYPE=network
# PRINTER_HOST=192.168.1.100
# PRINTER_NETWORK_PORT=9100

# Windows printer name
# PRINTER_TYPE=win32
# PRINTER_NAME=EPSON TM-T88V

# Paper size: 58mm | 80mm
PAPER_SIZE=80mm

# Cafe open/close hours (24h, local time) — controls poll frequency
# 6am–4pm → poll every 1s; outside → poll every 30s
CAFE_OPEN_HOUR=6
CAFE_CLOSE_HOUR=16
