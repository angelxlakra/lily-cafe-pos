# Lily Cafe POS System - Environment Variables
# Copy this file to .env and update with your actual values.
#
# ----------------------------------------------------------------------------
# What belongs here, and what does not
# ----------------------------------------------------------------------------
# This file holds SECRETS and BOOTSTRAP values only — things the backend needs
# before it can reach the database.
#
# Everything else (restaurant name and address, GSTIN, FSSAI, GST rate, table
# count, timezone, token expiry, receipt paper size, review and feedback URLs,
# SMTP host/port/sender) is stored IN THE DATABASE and edited by the owner on
# the Settings page. Defaults live in backend/app/core/settings_store.py.
# Setting those as environment variables has no effect — the backend does not
# read them.
#
# In particular: the GST rate is the `app.gst_rate` setting (5% by default),
# not an environment variable.

# ============================================================================
# App Bootstrap
# ============================================================================
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=sqlite:///./restaurant.db

# ============================================================================
# CORS Origins (comma-separated)
# Add your local network IP here for mobile access
# Example: http://localhost:5173,http://192.168.1.100:5173
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ============================================================================
# Admin & Owner Credentials
# ============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# Owner Password Hash (for cash counter verification)
# A bcrypt hash used to verify the owner password when verifying daily cash
# counters. Generate a new hash with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
# The default below is for password "owner123" - CHANGE THIS IN PRODUCTION
OWNER_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW

# ============================================================================
# Sign-in brute-force protection
# ============================================================================
# A source address is locked out once it reaches this many failed logins
# inside the window.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15

# ============================================================================
# Print Relay Agent
# ============================================================================
# Shared secret between the backend and agent/agent.py. Must match
# AGENT_API_KEY in agent/.env.
PRINT_AGENT_API_KEY=change-me-in-production

# ============================================================================
# Ask — plain-language questions answered by fixed reports
# ============================================================================
# Without a key, the Ask screen reports that it is not set up on this server.
OPENAI_API_KEY=
ASK_MODEL=gpt-5.6-luna

# ============================================================================
# MCP server (optional) — lets the owner connect ChatGPT or Gemini
# ============================================================================
# Off by default. See DEPLOYMENT.md section 5 before enabling.
# MCP_PUBLIC_URL must be the exact public origin: scheme + host, no path,
# no trailing slash. It is the OAuth issuer identifier.
MCP_ENABLED=false
MCP_PUBLIC_URL=

# ============================================================================
# Email
# ============================================================================
# Only the password is a secret; host, port, username and sender address are
# configured on the Settings page.
SMTP_PASSWORD=

# ============================================================================
# Restaurant logo (local filesystem — not applicable in cloud deployment)
# ============================================================================
# Path to a logo image for printed receipts (PNG, JPG, ...). Leave empty for none.
# Example: /Users/yourusername/dev/lily-cafe-pos/backend/public/logos/logo.png
RESTAURANT_LOGO_PATH=

# ============================================================================
# Thermal Printer Configuration (local hardware)
# ============================================================================
# In the Fly.io + Vercel deployment this stays false: the Windows print agent
# does the printing. See DEPLOYMENT.md section 3.
#
# When enabled, the system automatically prints:
# 1. ORDER CHITS - when waiters save orders (kitchen tickets)
# 2. RECEIPTS   - when payment completes with ?auto_print=true
PRINTER_ENABLED=false

# Printer connection type: "win32", "usb", or "serial"
# - win32: Windows printer (recommended for Windows)
# - usb: Direct USB connection
# - serial: Serial port connection
PRINTER_TYPE=

# Windows Printer Configuration (when PRINTER_TYPE=win32)
# Run detect_printer.py to find your printer name
# Example: PRINTER_NAME=Essae POS-60C
PRINTER_NAME=

# USB Printer Configuration (when PRINTER_TYPE=usb)
# Run detect_printer.py to find your printer's VID and PID
# Format: hexadecimal (with or without the 0x prefix)
# Example: PRINTER_VENDOR_ID=0x0dd4 or PRINTER_VENDOR_ID=0dd4
PRINTER_VENDOR_ID=
PRINTER_PRODUCT_ID=

# Serial Printer Configuration (when PRINTER_TYPE=serial)
# Port name: COM1, COM3, etc. (Windows) or /dev/ttyUSB0 (Linux)
PRINTER_PORT=
PRINTER_BAUDRATE=9600

# ============================================================================
# How to Configure Your Printer
# ============================================================================
# 1. Connect your thermal printer via USB
# 2. Run: cd backend && uv run python detect_printer.py
# 3. The script detects your printer and shows the configuration values
# 4. Copy the suggested values into this .env file
# 5. Set PRINTER_ENABLED=true
# 6. Restart the backend server
# 7. Test with: GET /api/v1/orders/{order_id}/receipt?auto_print=true
