# Secrets and bootstrap values only.
#
# Restaurant details, GST rate, table count, timezone, token expiry, receipt
# paper size and the review/feedback URLs live IN THE DATABASE and are edited
# by the owner on the Settings page (defaults: app/core/settings_store.py).
# Setting them here has no effect. The GST rate in particular is the
# `app.gst_rate` setting, 5% by default — not an environment variable.

# App
SECRET_KEY=generate-a-strong-random-key-here

# Database — Fly.io mounts /data as a persistent volume
DATABASE_URL=sqlite:////data/restaurant.db

# CORS — add your Vercel frontend URL
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Admin & owner credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123
OWNER_PASSWORD_HASH=

# Sign-in brute-force protection
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15

# Print relay agent — must match AGENT_API_KEY in agent/.env
PRINT_AGENT_API_KEY=generate-a-strong-random-key-here

# Ask — without a key the Ask screen reports it is not set up on this server
OPENAI_API_KEY=
ASK_MODEL=gpt-5.6-luna

# MCP server (optional) — see DEPLOYMENT.md section 5 before enabling.
# MCP_PUBLIC_URL is the OAuth issuer: scheme + host, no path, no trailing slash.
MCP_ENABLED=false
MCP_PUBLIC_URL=

# Email — only the password is a secret; the rest is on the Settings page
SMTP_PASSWORD=

# Thermal printer — DISABLED in cloud (agent handles printing locally)
PRINTER_ENABLED=false
